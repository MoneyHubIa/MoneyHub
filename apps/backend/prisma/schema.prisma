generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firebaseUid     String    @unique @map("firebase_uid") @db.VarChar(128)
  email           String    @unique @db.VarChar(320)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  status          String    @default("ACTIVE") @db.VarChar(20)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile               Profile?
  categories            FinancialCategory[]
  costCenters           CostCenter[]
  incomes               Income[]
  expenses              Expense[]
  accountsPayable       AccountPayable[]
  accountsReceivable    AccountReceivable[]
  recurringTransactions RecurringTransaction[]
  calendarEvents        CalendarEvent[]
  notifications         Notification[]
  financialAccounts     FinancialAccount[]
  financialGoals        FinancialGoal[]

  @@map("users")
}

model Profile {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  fullName          String   @map("full_name") @db.VarChar(120)
  preferredCurrency String   @default("BRL") @map("preferred_currency") @db.Char(3)
  theme             String   @default("SYSTEM") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model FinancialCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(60)
  type      String   @default("BOTH") @db.VarChar(20)
  color     String   @default("#4A5568") @db.VarChar(20)
  icon      String   @default("tag") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomes           Income[]
  expenses          Expense[]
  accountsPayable   AccountPayable[]
  accountsReceivable AccountReceivable[]
  recurringTransactions RecurringTransaction[]

  @@index([userId, deletedAt])
  @@map("financial_categories")
}

model CostCenter {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String    @db.VarChar(60)
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomes           Income[]
  expenses          Expense[]
  accountsPayable   AccountPayable[]
  accountsReceivable AccountReceivable[]
  recurringTransactions RecurringTransaction[]

  @@index([userId, deletedAt])
  @@map("cost_centers")
}

model Income {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  financialAccountId String @default(dbgenerated("NULL::uuid")) @map("financial_account_id") @db.Uuid
  financialAccount FinancialAccount @relation(fields: [userId, financialAccountId], references: [userId, id])
  userId       String      @map("user_id") @db.Uuid
  categoryId   String      @map("category_id") @db.Uuid
  costCenterId String?     @map("cost_center_id") @db.Uuid
  description  String      @db.VarChar(120)
  amount       Decimal     @db.Decimal(12, 2)
  occurredAt   DateTime    @map("occurred_at") @db.Timestamptz(3)
  notes        String?     @db.VarChar(500)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(3)

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   FinancialCategory @relation(fields: [categoryId], references: [id])
  costCenter CostCenter?       @relation(fields: [costCenterId], references: [id])

  @@index([userId, occurredAt, deletedAt])
  @@map("incomes")
  settlementId String? @unique @map("settlement_id") @db.Uuid
  @@index([userId, financialAccountId])
}

model Expense {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  financialAccountId String @default(dbgenerated("NULL::uuid")) @map("financial_account_id") @db.Uuid
  financialAccount FinancialAccount @relation(fields: [userId, financialAccountId], references: [userId, id])
  userId       String      @map("user_id") @db.Uuid
  categoryId   String      @map("category_id") @db.Uuid
  costCenterId String?     @map("cost_center_id") @db.Uuid
  description  String      @db.VarChar(120)
  amount       Decimal     @db.Decimal(12, 2)
  occurredAt   DateTime    @map("occurred_at") @db.Timestamptz(3)
  notes        String?     @db.VarChar(500)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(3)

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   FinancialCategory @relation(fields: [categoryId], references: [id])
  costCenter CostCenter?       @relation(fields: [costCenterId], references: [id])

  @@index([userId, occurredAt, deletedAt])
  @@map("expenses")
  settlementId String? @unique @map("settlement_id") @db.Uuid
  @@index([userId, financialAccountId])
}

model AccountPayable {
  cardStatementKey String? @unique @map("card_statement_key")
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  financialAccountId String @default(dbgenerated("NULL::uuid")) @map("financial_account_id") @db.Uuid
  financialAccount FinancialAccount @relation(fields: [userId, financialAccountId], references: [userId, id])
  userId       String      @map("user_id") @db.Uuid
  categoryId   String      @map("category_id") @db.Uuid
  costCenterId String?     @map("cost_center_id") @db.Uuid
  description  String      @db.VarChar(120)
  amount       Decimal     @db.Decimal(12, 2)
  dueDate      DateTime    @map("due_date") @db.Timestamptz(3)
  status       String      @default("PENDING") @db.VarChar(20)
  paidAt       DateTime?   @map("paid_at") @db.Timestamptz(3)
  reminderOffsetDays Int? @map("reminder_offset_days") @db.SmallInt
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(3)

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   FinancialCategory @relation(fields: [categoryId], references: [id])
  costCenter CostCenter?       @relation(fields: [costCenterId], references: [id])

  @@index([userId, dueDate, deletedAt])
  @@map("accounts_payable")
  seriesId String? @map("series_id") @db.Uuid
  installmentNumber Int? @map("installment_number")
  installmentTotal Int? @map("installment_total")
  @@unique([seriesId, installmentNumber])
  @@index([userId, financialAccountId])
}

model AccountReceivable {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  financialAccountId String @default(dbgenerated("NULL::uuid")) @map("financial_account_id") @db.Uuid
  financialAccount FinancialAccount @relation(fields: [userId, financialAccountId], references: [userId, id])
  userId       String      @map("user_id") @db.Uuid
  categoryId   String      @map("category_id") @db.Uuid
  costCenterId String?     @map("cost_center_id") @db.Uuid
  description  String      @db.VarChar(120)
  amount       Decimal     @db.Decimal(12, 2)
  dueDate      DateTime    @map("due_date") @db.Timestamptz(3)
  status       String      @default("PENDING") @db.VarChar(20)
  receivedAt   DateTime?   @map("received_at") @db.Timestamptz(3)
  reminderOffsetDays Int? @map("reminder_offset_days") @db.SmallInt
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(3)

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   FinancialCategory @relation(fields: [categoryId], references: [id])
  costCenter CostCenter?       @relation(fields: [costCenterId], references: [id])

  @@index([userId, dueDate, deletedAt])
  @@map("accounts_receivable")
  seriesId String? @map("series_id") @db.Uuid
  installmentNumber Int? @map("installment_number")
  installmentTotal Int? @map("installment_total")
  @@unique([seriesId, installmentNumber])
  @@index([userId, financialAccountId])
}

model RecurringTransaction {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  financialAccountId String @default(dbgenerated("NULL::uuid")) @map("financial_account_id") @db.Uuid
  financialAccount FinancialAccount @relation(fields: [userId, financialAccountId], references: [userId, id])
  userId         String    @map("user_id") @db.Uuid
  type           String    @db.VarChar(20)
  categoryId     String    @map("category_id") @db.Uuid
  costCenterId   String?   @map("cost_center_id") @db.Uuid
  description    String    @db.VarChar(120)
  amount         Decimal   @db.Decimal(12, 2)
  recurrenceRule String    @map("recurrence_rule") @db.VarChar(50)
  startDate      DateTime  @map("start_date") @db.Timestamptz(3)
  endDate        DateTime? @map("end_date") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   FinancialCategory @relation(fields: [categoryId], references: [id])
  costCenter CostCenter?       @relation(fields: [costCenterId], references: [id])

  @@index([userId])
  @@map("recurring_transactions")
  @@index([userId, financialAccountId])
}

model CalendarEvent {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  title             String    @db.VarChar(120)
  scheduledDate     DateTime  @map("scheduled_date") @db.Date
  recurrenceRule    String?   @map("recurrence_rule") @db.VarChar(20)
  recurrenceEndDate DateTime? @map("recurrence_end_date") @db.Date
  notes             String?   @db.VarChar(500)
  reminderOffsetDays Int? @map("reminder_offset_days") @db.SmallInt
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledDate])
  @@map("calendar_events")
}

model Notification {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  source         String   @db.VarChar(20)
  sourceId       String   @map("source_id") @db.Uuid
  title          String   @db.VarChar(120)
  occurrenceDate DateTime @map("occurrence_date") @db.Date
  reminderDate   DateTime @map("reminder_date") @db.Date
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, sourceId, occurrenceDate])
  @@index([userId, readAt, reminderDate])
  @@map("notifications")
}

model FinancialGoal {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  name              String    @db.VarChar(120)
  description       String?   @db.VarChar(500)
  targetAmount      Decimal   @map("target_amount") @db.Decimal(14, 2)
  accumulatedAmount Decimal   @default(0) @map("accumulated_amount") @db.Decimal(14, 2)
  startDate         DateTime  @map("start_date") @db.Date
  deadline          DateTime  @db.Date
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements         FinancialGoalMovement[]

  @@index([userId, deletedAt, deadline])
  @@map("financial_goals")
}

model FinancialGoalMovement {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goalId      String   @map("goal_id") @db.Uuid
  type        String   @db.VarChar(20)
  amount      Decimal  @db.Decimal(14, 2)
  occurredOn  DateTime @map("occurred_on") @db.Date
  notes       String?  @db.VarChar(500)
  operationId String   @map("operation_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  goal        FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, operationId])
  @@index([goalId, createdAt, id])
  @@map("financial_goal_movements")
}
model FinancialAccount {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String @db.VarChar(120)
  type String @default("CHECKING") @db.VarChar(20)
  accountNumber String? @map("account_number") @db.VarChar(120)
  additionalData String? @map("additional_data") @db.VarChar(1000)
  initialBalance Decimal @default(0) @map("initial_balance") @db.Decimal(18,2)
  isDefault Boolean @default(false) @map("is_default")
  archived Boolean @default(false)
  seedKey String? @map("seed_key")
  incomes Income[]
  expenses Expense[]
  payables AccountPayable[]
  receivables AccountReceivable[]
  recurring RecurringTransaction[]
  cards CreditCard[]
  outgoing Transfer[] @relation("transfer_source")
  incoming Transfer[] @relation("transfer_destination")
  @@unique([userId, seedKey])
  @@unique([userId, id])
  @@index([userId, archived])
  @@map("financial_accounts")
}
model Transfer {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  sourceId String @map("source_id") @db.Uuid
  destinationId String @map("destination_id") @db.Uuid
  source FinancialAccount @relation("transfer_source", fields: [userId, sourceId], references: [userId, id])
  destination FinancialAccount @relation("transfer_destination", fields: [userId, destinationId], references: [userId, id])
  amount Decimal @db.Decimal(12,2)
  dueDate DateTime @map("due_date") @db.Date
  effectiveDate DateTime? @map("effective_date") @db.Date
  status String @default("PENDING")
  operationId String @map("operation_id") @db.Uuid
  @@unique([userId, operationId])
  @@index([sourceId])
  @@index([destinationId])
  @@map("transfers")
}
model CreditCard {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  financialAccountId String @map("financial_account_id") @db.Uuid
  account FinancialAccount @relation(fields: [userId, financialAccountId], references: [userId, id])
  name String @db.VarChar(120)
  brand String @db.VarChar(60)
  creditLimit Decimal @map("credit_limit") @db.Decimal(12,2)
  dueDay Int @map("due_day")
  closingDay Int @map("closing_day")
  dynamicDays Int? @map("dynamic_days")
  businessDays Boolean @default(false) @map("business_days")
  isPrimary Boolean @default(false) @map("is_primary")
  archived Boolean @default(false)
  purchases CreditCardPurchase[]
  payments CreditCardPayment[]
  @@index([userId, archived])
  @@index([financialAccountId])
  @@map("credit_cards")
}
model CreditCardPurchase {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId String @map("card_id") @db.Uuid
  card CreditCard @relation(fields: [cardId], references: [id])
  categoryId String @map("category_id") @db.Uuid
  description String @db.VarChar(120)
  amount Decimal @db.Decimal(12,2)
  paidAmount Decimal @default(0) @map("paid_amount") @db.Decimal(12,2)
  dueDate DateTime @map("due_date") @db.Date
  closingDate DateTime @map("closing_date") @db.Date
  installmentNumber Int @map("installment_number")
  installmentTotal Int @map("installment_total")
  operationId String @map("operation_id") @db.Uuid
  @@unique([cardId, operationId, installmentNumber])
  @@index([cardId, dueDate])
  @@map("credit_card_purchases")
}
model CreditCardPayment {
  allocations Json @default("{}")
  reversed Boolean @default(false)
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId String @map("card_id") @db.Uuid
  card CreditCard @relation(fields: [cardId], references: [id])
  amount Decimal @db.Decimal(12,2)
  paidOn DateTime @map("paid_on") @db.Date
  dueDate DateTime @map("due_date") @db.Date
  operationId String @map("operation_id") @db.Uuid
  @@unique([cardId, operationId])
  @@map("credit_card_payments")
}
model FinancialSeries {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  spec Json
  cancelled Boolean @default(false)
  @@index([userId, cancelled])
  @@map("financial_series")
}

model FinancialAudit {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  entityKind String @map("entity_kind")
  entityId String @map("entity_id") @db.Uuid
  before Json?
  after Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([userId, createdAt, id])
  @@map("financial_audit")
}
