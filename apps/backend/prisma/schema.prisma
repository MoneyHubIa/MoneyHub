generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firebaseUid     String    @unique @map("firebase_uid") @db.VarChar(128)
  email           String    @unique @db.VarChar(320)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  status          String    @default("ACTIVE") @db.VarChar(20)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile         Profile?

  @@map("users")
}

model Profile {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  fullName          String   @map("full_name") @db.VarChar(120)
  preferredCurrency String   @default("BRL") @map("preferred_currency") @db.Char(3)
  theme             String   @default("SYSTEM") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}
