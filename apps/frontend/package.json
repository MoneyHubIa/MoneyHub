{
  "name": "@moneyhub/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "start:web": "expo start --web",
    "build": "expo export --platform all --output-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:auth-emulator": "firebase emulators:exec --project demo-moneyhub --only auth \"node --test integration/auth-emulator.test.mjs\"",
    "lint": "eslint app src tests integration"
  },
  "dependencies": {
    "@apollo/client": "^4.2.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^25.1.0",
    "@react-native-firebase/app": "^25.1.0",
    "expo": "^57.0.8",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.8",
    "expo-linking": "~57.0.4",
    "expo-router": "^57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "firebase": "^12.16.0",
    "graphql": "^16.14.2",
    "lucide-react-native": "^1.25.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "babel-jest": "^29.7.0",
    "eslint": "^9.9.1",
    "expo-doctor": "^1.20.1",
    "firebase-tools": "^15.24.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/../../node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setupTests.ts"
    ]
  }
}
