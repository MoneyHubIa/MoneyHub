{
  "expo": {
    "name": "MoneyHub",
    "slug": "moneyhub",
    "scheme": "moneyhub",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permita que o MoneyHub use o microfone para ditar mensagens ao assistente financeiro.",
          "speechRecognitionPermission": "Permita que o MoneyHub converta sua fala em texto para o assistente financeiro."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/analytics"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
