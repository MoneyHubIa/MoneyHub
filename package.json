{
  "name": "moneyhub",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "MoneyHub monorepo",
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "scripts": {
    "test": "npm run test:release && npm run test --workspaces --if-present",
    "test:release": "node --test \"scripts/tests/*.test.mjs\"",
    "lint": "npm run lint --workspaces --if-present && npm run lint:e2e && npm run lint:release",
    "lint:e2e": "eslint e2e playwright.config.ts",
    "lint:release": "eslint scripts",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs --dry-run --ci",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:backend": "npm run dev -w apps/backend",
    "dev:frontend": "npm run dev -w apps/frontend",
    "test:e2e": "node e2e/run.mjs",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "dev": "concurrently --kill-others --names BACK,FRONT \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "overrides": {
    "jwks-rsa": "3.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@release-it/conventional-changelog": "11.0.1",
    "concurrently": "^10.0.6",
    "release-it": "20.2.1",
    "typescript-eslint": "^8.65.0"
  }
}
