# Somente valores de desenvolvimento. Nunca adicione segredos reais neste arquivo.
# Docker Compose: copiar para .env é opcional; os mesmos padrões estão no compose.yaml.
# Máximo de requisições GraphQL por IP durante a janela.
MONEYHUB_RATE_LIMIT_MAX=100
# Duração da janela em milissegundos (900000 = 15 minutos).
MONEYHUB_RATE_LIMIT_WINDOW_MS=900000

# Desenvolvimento sem Docker: estas variáveis não sobrescrevem a configuração
# dos containers. Requer PostgreSQL e Auth Emulator disponíveis na máquina.
# No Docker, o app fica em http://localhost:8080 e o banco usa db:5432 internamente.
APP_URL=http://localhost:3000
PORT=3000

FIREBASE_PROJECT_ID=demo-moneyhub
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_WEB_API_KEY=demo-api-key
DATABASE_URL=postgresql://moneyhub:moneyhub@localhost:5432/moneyhub?sslmode=disable
DIRECT_URL=postgresql://moneyhub:moneyhub@localhost:5432/moneyhub?sslmode=disable
LLM_PROVIDER=mock

EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-moneyhub.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-moneyhub
EXPO_PUBLIC_FIREBASE_APP_ID=demo-app-id
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
