APP_URL=http://localhost:3000

FIREBASE_PROJECT_ID=demo-moneyhub
GOOGLE_APPLICATION_CREDENTIALS=apps/backend/credentials/service-account.json
# Database connection (Supabase Pooler on port 6543 for production runtime, or local PostgreSQL)
DATABASE_URL=postgresql://moneyhub:moneyhub@localhost:5432/moneyhub
# Direct database connection (Supabase direct port 5432 for Prisma migrations)
DIRECT_URL=postgresql://moneyhub:moneyhub@localhost:5432/moneyhub
FIREBASE_WEB_API_KEY=

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-moneyhub.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-moneyhub
EXPO_PUBLIC_FIREBASE_APP_ID=
